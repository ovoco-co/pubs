<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" class="in-text" version="1.0" demote-non-dropping-particle="never" default-locale="en-US">
  <info>
    <title>NIST Technical Series (author-date, house style)</title>
    <title-short>NIST author-date</title-short>
    <id>http://www.zotero.org/styles/nist-author-date-house</id>
    <link href="http://www.zotero.org/styles/nist-author-date-house" rel="self"/>
    <link href="https://www.nist.gov/nist-research-library/reference-format-nist-publications" rel="documentation"/>
    <author>
      <name>FedWriters (NWIRP 2-1)</name>
    </author>
    <category citation-format="author-date"/>
    <category field="engineering"/>
    <summary>In-text citations in Chicago author-date form without a comma, (FCC 2020), (Maitland and Peha 2018), (Cordova et al. 2021). Reference list in the NIST Technical Series reference format: Taylor BN (2011) Title. Journal 116(6):797. https://doi.org/...</summary>
    <updated>2026-11-23T00:00:00+00:00</updated>
    <rights license="http://creativecommons.org/licenses/by-sa/3.0/">This work is licensed under a Creative Commons Attribution-ShareAlike 3.0 License</rights>
  </info>
  <locale xml:lang="en">
    <terms>
      <term name="section" form="short">sec.</term>
      <term name="no date" form="short">n.d.</term>
      <term name="et-al">et al.</term>
    </terms>
  </locale>

  <!-- ============================================================ names -->
  <macro name="author-short">
    <names variable="author">
      <name form="short" and="text" delimiter=", " delimiter-precedes-last="never" et-al-min="3" et-al-use-first="1"/>
      <substitute>
        <names variable="editor"/>
        <names variable="director"/>
        <text macro="title-short"/>
      </substitute>
    </names>
  </macro>
  <macro name="author-bib">
    <!-- NIST: family name then initials, no periods or spaces: Acosta FJ, Wood SG -->
    <names variable="author">
      <name name-as-sort-order="all" sort-separator=" " initialize-with="" delimiter=", " delimiter-precedes-last="always"/>
      <label form="short" prefix=", "/>
      <substitute>
        <names variable="editor"/>
        <names variable="director"/>
        <text macro="title"/>
      </substitute>
    </names>
  </macro>
  <macro name="editor-bib">
    <names variable="editor">
      <name initialize-with="" name-as-sort-order="all" sort-separator=" " delimiter=", "/>
      <label form="short" prefix=", "/>
    </names>
  </macro>

  <!-- ============================================================ dates -->
  <macro name="year">
    <choose>
      <if variable="issued">
        <!-- year-suffix is rendered explicitly below for n.d., and CSL then stops adding it
             to the first date on its own, so it is rendered explicitly here too (2018a) -->
        <group>
          <date variable="issued">
            <date-part name="year"/>
          </date>
          <text variable="year-suffix"/>
        </group>
      </if>
      <else>
        <!-- an undated source renders no date for the year-suffix to attach to, so add it:
             two undated FCC pages become n.d.-a and n.d.-b -->
        <group delimiter="-">
          <text term="no date" form="short"/>
          <text variable="year-suffix"/>
        </group>
      </else>
    </choose>
  </macro>
  <macro name="year-sort">
    <date variable="issued">
      <date-part name="year"/>
    </date>
  </macro>

  <!-- ============================================================ titles -->
  <macro name="title">
    <!-- NIST format: report, web page, dataset and book titles in title case ("Security
         Requirements for Cryptographic Modules"); article, paper and chapter titles as
         entered ("The current SI seen from the perspective of the proposed new SI") -->
    <choose>
      <if type="legislation bill legal_case" match="any">
        <text variable="title"/>
      </if>
      <else-if type="book report thesis software dataset" match="any">
        <text variable="title" font-style="italic" text-case="title"/>
      </else-if>
      <else-if type="article-journal article-magazine article-newspaper paper-conference chapter entry entry-dictionary entry-encyclopedia" match="any">
        <text variable="title"/>
      </else-if>
      <else>
        <text variable="title" text-case="title"/>
      </else>
    </choose>
  </macro>
  <macro name="title-short">
    <choose>
      <if type="book report thesis software dataset" match="any">
        <text variable="title" form="short" font-style="italic" text-case="title"/>
      </if>
      <else-if type="article-journal article-magazine article-newspaper paper-conference chapter entry entry-dictionary entry-encyclopedia legislation bill legal_case" match="any">
        <text variable="title" form="short"/>
      </else-if>
      <else>
        <text variable="title" form="short" text-case="title"/>
      </else>
    </choose>
  </macro>

  <!-- ============================================================ pieces -->
  <macro name="publisher">
    <!-- NIST: (Publisher, Place) -->
    <group delimiter=", " prefix="(" suffix=")">
      <text variable="publisher"/>
      <text variable="publisher-place"/>
    </group>
  </macro>
  <macro name="series-number">
    <group delimiter=" ">
      <text variable="collection-title"/>
      <text variable="number"/>
    </group>
  </macro>
  <macro name="access">
    <choose>
      <if variable="DOI">
        <text variable="DOI" prefix="https://doi.org/"/>
      </if>
      <else-if variable="URL">
        <text value="Available at "/>
        <text variable="URL"/>
      </else-if>
    </choose>
  </macro>
  <macro name="locator">
    <choose>
      <if locator="page">
        <text variable="locator"/>
      </if>
      <else>
        <group delimiter=" ">
          <label variable="locator" form="short"/>
          <text variable="locator"/>
        </group>
      </else>
    </choose>
  </macro>

  <!-- ============================================================ body by type -->
  <macro name="body">
    <choose>
      <!-- Journal article: Title. Journal 116(6):797. -->
      <if type="article-journal">
        <group delimiter=". ">
          <text macro="title"/>
          <group>
            <text variable="container-title" font-style="italic"/>
            <choose>
              <if variable="volume">
                <text variable="volume" prefix=" "/>
                <text variable="issue" prefix="(" suffix=")"/>
              </if>
              <else>
                <!-- no volume: keep the issue off the journal name ("Social Research Update (35)") -->
                <text variable="issue" prefix=" (" suffix=")"/>
              </else>
            </choose>
            <text variable="page" prefix=":"/>
          </group>
        </group>
      </if>
      <!-- Conference paper: Title. Proceedings (Publisher, Place), pp 1-8. -->
      <else-if type="paper-conference">
        <group delimiter=". ">
          <text macro="title"/>
          <group delimiter=", ">
            <group delimiter=" ">
              <choose>
                <if variable="container-title">
                  <text variable="container-title" font-style="italic"/>
                </if>
                <else>
                  <text variable="event-title" font-style="italic"/>
                </else>
              </choose>
              <text macro="publisher"/>
            </group>
            <text variable="page" prefix="pp "/>
          </group>
        </group>
      </else-if>
      <!-- Chapter: Title. Book, ed Editor (Publisher, Place), pp 1-8. -->
      <else-if type="chapter">
        <group delimiter=". ">
          <text macro="title"/>
          <group delimiter=", ">
            <group delimiter=" ">
              <text variable="container-title" font-style="italic"/>
              <text macro="editor-bib" prefix="ed "/>
              <text macro="publisher"/>
            </group>
            <text variable="page" prefix="pp "/>
          </group>
        </group>
      </else-if>
      <!-- Report: Title. (Publisher, Place), Series Number. -->
      <else-if type="report">
        <group delimiter=". ">
          <text macro="title"/>
          <group delimiter=", ">
            <text macro="publisher"/>
            <text macro="series-number"/>
          </group>
        </group>
      </else-if>
      <!-- Thesis: Title. Ph.D. Thesis. (University, Place). -->
      <else-if type="thesis">
        <group delimiter=". ">
          <text macro="title"/>
          <text variable="genre"/>
          <text macro="publisher"/>
        </group>
      </else-if>
      <!-- Book: Title. Edition (Publisher, Place). -->
      <else-if type="book">
        <group delimiter=". ">
          <text macro="title"/>
          <group delimiter=" ">
            <group delimiter=" ">
              <number variable="edition" form="ordinal"/>
              <text value="edition"/>
            </group>
            <text macro="publisher"/>
          </group>
        </group>
      </else-if>
      <!-- Statute: Title, Code Volume § Section -->
      <else-if type="legislation bill" match="any">
        <group delimiter=", ">
          <text macro="title"/>
          <group delimiter=" ">
            <text variable="number" prefix="Public Law "/>
            <text variable="volume"/>
            <text variable="container-title"/>
            <text variable="section" prefix="§ "/>
          </group>
        </group>
      </else-if>
      <!-- Newspaper / magazine: Title. Publication. -->
      <else-if type="article-newspaper article-magazine" match="any">
        <group delimiter=". ">
          <text macro="title"/>
          <text variable="container-title" font-style="italic"/>
        </group>
      </else-if>
      <!-- Web page, post: Title. Site. -->
      <else-if type="webpage post-weblog post" match="any">
        <group delimiter=". ">
          <text macro="title"/>
          <text variable="container-title"/>
        </group>
      </else-if>
      <!-- Everything else (document, dataset, software, letter, interview, speech): Title. Genre. (Publisher, Place) -->
      <else>
        <group delimiter=". ">
          <text macro="title"/>
          <group delimiter=" ">
            <text variable="genre"/>
            <text variable="version" prefix="Version "/>
          </group>
          <group delimiter=" ">
            <text variable="event-title"/>
            <text macro="publisher"/>
          </group>
        </group>
      </else>
    </choose>
  </macro>

  <!-- ============================================================ citation -->
  <citation et-al-min="3" et-al-use-first="1" disambiguate-add-year-suffix="true" disambiguate-add-names="false"
            disambiguate-add-givenname="false" collapse="year" cite-group-delimiter=", " after-collapse-delimiter="; "
            year-suffix-delimiter=", ">
    <sort>
      <key macro="year-sort"/>
      <key macro="author-short"/>
    </sort>
    <layout prefix="(" suffix=")" delimiter="; ">
      <group delimiter=", ">
        <group delimiter=" ">
          <text macro="author-short"/>
          <text macro="year"/>
        </group>
        <text macro="locator"/>
      </group>
    </layout>
  </citation>

  <!-- ============================================================ bibliography -->
  <bibliography hanging-indent="true" entry-spacing="0">
    <sort>
      <key macro="author-bib"/>
      <!-- full date, not just the year: same-author, same-year entries then run in date
           order, so Zotero's a/b letters follow the calendar (2018a is the earlier letter) -->
      <key variable="issued"/>
      <key variable="title"/>
    </sort>
    <layout suffix="">
      <group delimiter=" ">
        <text macro="author-bib"/>
        <text macro="year" prefix="(" suffix=")"/>
        <group delimiter=". " suffix=".">
          <text macro="body"/>
        </group>
        <text macro="access"/>
      </group>
    </layout>
  </bibliography>
</style>
